  <script>
    window.dataLayer = window.dataLayer || [];

    document.querySelectorAll('.js-checkout').forEach(function(button){
      button.addEventListener('click', function(){
        window.dataLayer.push({
          event: 'cta_click',
          cta_name: 'parto_sem_medo_checkout',
          cta_position: button.getAttribute('data-position') || 'unknown',
          destination: 'cakto_checkout',
          product_name: 'Parto Sem Medo',
          product_price: 97
        });
      });
    });

    // Eventos simples de profundidade para o GTM/GA4.
    (function(){
      const fired = new Set();
      function trackScroll(){
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        if(max <= 0) return;
        const pct = Math.round((window.scrollY / max) * 100);

        [50,75,90].forEach(function(mark){
          if(pct >= mark && !fired.has(mark)){
            fired.add(mark);
            window.dataLayer.push({
              event: 'scroll_depth',
              scroll_percent: mark,
              page_type: 'sales_page',
              product_name: 'Parto Sem Medo'
            });
          }
        });
      }

      window.addEventListener('scroll', trackScroll, {passive:true});
    })();
  </script>
