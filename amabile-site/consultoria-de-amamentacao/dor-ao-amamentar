  <script>


    const WHATSAPP_NUMBER = '67998291425';



    const PACKAGE_DATA = {


      essencial: {

        name:
          'Consulta Essencial',

        price:
          347

      },


      acompanhamento: {

        name:
          'Acompanhamento',

        price:
          497

      },


      completo: {

        name:
          'Acompanhamento Completo',

        price:
          647

      }


    };



    window.dataLayer =
      window.dataLayer || [];



    function pushEvent(
      eventName,
      data = {}
    ) {


      window.dataLayer.push({


        event:
          eventName,


        ...data


      });


    }



    document
      .querySelectorAll(
        '.js-whatsapp-package'
      )
      .forEach(button => {


        button.addEventListener(
          'click',
          () => {


            const packageId =
              button.dataset.packageId;


            const packageData =
              PACKAGE_DATA[packageId];


            if (!packageData) {

              return;

            }



            pushEvent(
              'package_select',
              {


                package_id:
                  packageId,


                package_name:
                  packageData.name,


                package_price:
                  packageData.price,


                currency:
                  'BRL',


                landing_intent:
                  'dor_ao_amamentar'


              }
            );



            sessionStorage.setItem(
              'selected_package',
              packageId
            );



            if (
              !WHATSAPP_NUMBER ||

              WHATSAPP_NUMBER.includes(
                'INSIRA_AQUI'
              )
            ) {


              alert(
                'O número do WhatsApp ainda não foi configurado.'
              );


              return;

            }



            const message =


              `Olá! Vim pelo site da Amábile porque estou enfrentando dor ou desconforto durante a amamentação.\n\n` +


              `A opção que mais me interessou foi:\n` +


              `*${packageData.name} — R$ ${packageData.price}*\n\n` +


              `Gostaria de tirar algumas dúvidas sobre o atendimento e saber sobre a disponibilidade de horários.`;



            pushEvent(
              'whatsapp_start',
              {


                package_id:
                  packageId,


                package_name:
                  packageData.name,


                package_price:
                  packageData.price,


                currency:
                  'BRL',


                landing_intent:
                  'dor_ao_amamentar'


              }
            );



            const whatsappURL =


              `https://wa.me/${WHATSAPP_NUMBER}` +

              `?text=${encodeURIComponent(message)}`;



            window.open(
              whatsappURL,
              '_blank',
              'noopener,noreferrer'
            );


          }
        );


      });



    document
      .querySelectorAll(
        '[data-track]'
      )
      .forEach(element => {


        element.addEventListener(
          'click',
          () => {


            pushEvent(
              'lp_cta_click',
              {


                cta_name:
                  element.dataset.track,


                landing_intent:
                  'dor_ao_amamentar'


              }
            );


          }
        );


      });



    pushEvent(
      'consultoria_amamentacao_lp_view',
      {


        page_type:
          'consultoria_amamentacao',


        landing_intent:
          'dor_ao_amamentar'


      }
    );


  </script>


