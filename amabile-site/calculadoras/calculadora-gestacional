    const TOTAL_DAYS = 280;
    let activeTab = "dum";

    const tabs = document.querySelectorAll(".tab");
    const panels = {
      dum: document.getElementById("panel-dum"),
      dpp: document.getElementById("panel-dpp"),
      usg: document.getElementById("panel-usg")
    };

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        activeTab = tab.dataset.tab;
        tabs.forEach(item => item.classList.remove("active"));
        tab.classList.add("active");
        Object.keys(panels).forEach(key => {
          panels[key].style.display = key === activeTab ? "block" : "none";
        });
        hideMessage();
      });
    });

    function parseLocalDate(value) {
      if (!value) return null;
      const [year, month, day] = value.split("-").map(Number);
      return new Date(year, month - 1, day);
    }

    function todayLocal() {
      const now = new Date();
      return new Date(now.getFullYear(), now.getMonth(), now.getDate());
    }

    function addDays(date, days) {
      const result = new Date(date);
      result.setDate(result.getDate() + days);
      return result;
    }

    function diffDays(start, end) {
      const startUTC = Date.UTC(start.getFullYear(), start.getMonth(), start.getDate());
      const endUTC = Date.UTC(end.getFullYear(), end.getMonth(), end.getDate());
      return Math.round((endUTC - startUTC) / MS_PER_DAY);
    }

    function formatDate(date) {
      return date.toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit", year: "numeric" });
    }

    function showError(message) {
      const errorBox = document.getElementById("errorBox");
      errorBox.textContent = message;
      errorBox.style.display = "block";
      document.getElementById("resultBox").style.display = "none";
    }

    function hideMessage() {
      document.getElementById("errorBox").style.display = "none";
    }

    function trimesterByDays(days) {
      if (days < 98) return "1º trimestre";
      if (days < 196) return "2º trimestre";
      return "3º trimestre";
    }

    function noteByWeeks(weeks) {
      if (weeks < 13) return "Você está no início da gestação. Essa costuma ser uma fase de muitas descobertas, sintomas e adaptações.";
      if (weeks < 28) return "Você está em uma fase em que muitas gestantes começam a sentir mais disposição e acompanhar melhor os movimentos do bebê.";
      if (weeks < 37) return "Você está se aproximando da reta final. É um bom momento para organizar a mala, revisar o plano de parto e fortalecer seu preparo emocional.";
      if (weeks <= 42) return "Você está na fase final da gestação. Observe sinais do trabalho de parto e mantenha contato com sua equipe de saúde.";
      return "O resultado passou de 42 semanas. Confira se a data informada está correta e converse com sua equipe de saúde.";
    }

    function calculateReferenceDate() {
      const today = todayLocal();

      if (activeTab === "dum") {
        const dum = parseLocalDate(document.getElementById("dumDate").value);
        if (!dum) throw new Error("Informe o primeiro dia da sua última menstruação.");
        if (dum > today) throw new Error("A data da última menstruação não pode estar no futuro.");
        return dum;
      }

      if (activeTab === "dpp") {
        const dpp = parseLocalDate(document.getElementById("dppDate").value);
        if (!dpp) throw new Error("Informe a data provável do parto.");
        return addDays(dpp, -TOTAL_DAYS);
      }

      const usgDate = parseLocalDate(document.getElementById("usgDate").value);
      const weeks = Number(document.getElementById("usgWeeks").value);
      const days = Number(document.getElementById("usgDays").value || 0);

      if (!usgDate) throw new Error("Informe a data em que o ultrassom foi feito.");
      if (usgDate > today) throw new Error("A data do ultrassom não pode estar no futuro.");
      if (!weeks || weeks < 1 || weeks > 42) throw new Error("Informe as semanas do ultrassom entre 1 e 42.");
      if (days < 0 || days > 6) throw new Error("Informe os dias do ultrassom entre 0 e 6.");

      const gestationalDaysAtUSG = (weeks * 7) + days;
      return addDays(usgDate, -gestationalDaysAtUSG);
    }

    document.getElementById("gestationForm").addEventListener("submit", function(event) {
      event.preventDefault();
      hideMessage();

      try {
        const startDate = calculateReferenceDate();
        const today = todayLocal();
        const gestationalDays = diffDays(startDate, today);

        if (gestationalDays < 0) throw new Error("A data informada gera uma idade gestacional negativa. Confira os dados.");
        if (gestationalDays > 310) throw new Error("O resultado ficou acima do esperado para uma gestação. Confira se a data foi preenchida corretamente.");

        const weeks = Math.floor(gestationalDays / 7);
        const days = gestationalDays % 7;
        const dueDate = addDays(startDate, TOTAL_DAYS);
        const remainingDays = TOTAL_DAYS - gestationalDays;
        const progress = Math.max(0, Math.min(100, Math.round((gestationalDays / TOTAL_DAYS) * 100)));

        document.getElementById("gestAge").textContent = `${weeks} semanas e ${days} dias`;
        document.getElementById("dueDate").textContent = formatDate(dueDate);
        document.getElementById("trimester").textContent = trimesterByDays(gestationalDays);
        document.getElementById("remaining").textContent = remainingDays > 0 ? `${remainingDays} dias` : "DPP atingida";
        document.getElementById("progressText").textContent = `${progress}%`;
        document.getElementById("progressBar").style.width = `${progress}%`;
        document.getElementById("resultNote").textContent = noteByWeeks(weeks);
        document.getElementById("resultBox").style.display = "block";
      } catch (error) {
        showError(error.message);
      }
    });

    document.getElementById("clearBtn").addEventListener("click", function() {
      document.getElementById("gestationForm").reset();
      document.getElementById("resultBox").style.display = "none";
      hideMessage();
    });
  </script>

<script>
document.querySelectorAll('.faq-question').forEach(button => {
  button.addEventListener('click', () => {
    const item = button.parentElement;
    item.classList.toggle('active');
  });
});
</script>

